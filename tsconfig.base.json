{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@ksp/auth": ["packages/auth/src/index.ts"],
      "@ksp/auth/*": ["packages/auth/src/*"],
      "@ksp/config": ["packages/config/src/index.ts"],
      "@ksp/config/*": ["packages/config/src/*"],
      "@ksp/database": ["packages/database/src/index.ts"],
      "@ksp/database/*": ["packages/database/src/*"],
      "@ksp/domain": ["packages/domain/src/index.ts"],
      "@ksp/domain/*": ["packages/domain/src/*"],
      "@ksp/finance": ["packages/finance/src/index.ts"],
      "@ksp/finance/*": ["packages/finance/src/*"],
      "@ksp/integrations": ["packages/integrations/src/index.ts"],
      "@ksp/integrations/*": ["packages/integrations/src/*"],
      "@ksp/notifications": ["packages/notifications/src/index.ts"],
      "@ksp/notifications/*": ["packages/notifications/src/*"],
      "@ksp/observability": ["packages/observability/src/index.ts"],
      "@ksp/observability/*": ["packages/observability/src/*"],
      "@ksp/permissions": ["packages/permissions/src/index.ts"],
      "@ksp/permissions/*": ["packages/permissions/src/*"],
      "@ksp/testing": ["packages/testing/src/index.ts"],
      "@ksp/testing/*": ["packages/testing/src/*"],
      "@ksp/ui": ["packages/ui/src/index.tsx"],
      "@ksp/ui/*": ["packages/ui/src/*"],
      "@ksp/validation": ["packages/validation/src/index.ts"],
      "@ksp/validation/*": ["packages/validation/src/*"]
    },
    "ignoreDeprecations": "6.0"
  }
}
