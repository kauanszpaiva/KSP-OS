{
  "openapi": "3.1.0",
  "info": {
    "title": "KSP Command OS — Read API",
    "version": "1.0.0",
    "description": "RLS-scoped access to KSP Command OS for AI connectors (ChatGPT Actions / Claude MCP). Every request runs as the authenticated user; it never returns or changes more than that user could in the app. Writes are limited to low-risk internal actions (create task, add comment, create mission); sensitive/material actions (finance, access grants, deploys, publishing to clients) are intentionally not exposed."
  },
  "servers": [{ "url": "https://REPLACE-WITH-YOUR-COMMAND-HOST/api/v1", "description": "Command app v1 API (replace host)" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/me": {
      "get": {
        "operationId": "getMe",
        "summary": "The authenticated user, their organization, and internal roles.",
        "responses": { "200": { "description": "Current user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Me" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/missions": {
      "get": {
        "operationId": "listMissions",
        "summary": "Missions (projects) visible to the user, with client, milestones, and dependencies.",
        "responses": { "200": { "description": "Missions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataList" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "post": {
        "operationId": "createMission",
        "summary": "Create a mission (requires project.manage). Low-risk internal write.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object", "required": ["name", "projectType"],
            "properties": {
              "name": { "type": "string" },
              "projectType": { "type": "string", "enum": ["engagement", "product", "campaign", "internal"] },
              "clientId": { "type": "string", "description": "Optional client organization id to link." }
            }
          } } }
        },
        "responses": { "201": { "$ref": "#/components/responses/Created" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "description": "Not permitted." } }
      }
    },
    "/clients": {
      "get": {
        "operationId": "listClients",
        "summary": "Client organizations visible to the user, with contacts and internal notes.",
        "responses": { "200": { "description": "Clients", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataList" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/tasks": {
      "get": {
        "operationId": "listTasks",
        "summary": "Workspace tasks visible to the user, with owner and project names.",
        "responses": { "200": { "description": "Tasks", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataList" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "post": {
        "operationId": "createTask",
        "summary": "Create a workspace task. Low-risk internal write.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object", "required": ["title"],
            "properties": {
              "title": { "type": "string" },
              "projectId": { "type": "string", "description": "Optional mission/project id." },
              "ownerId": { "type": "string", "description": "Optional owner profile id; defaults to the caller." },
              "startDate": { "type": "string", "format": "date" },
              "dueDate": { "type": "string", "format": "date" }
            }
          } } }
        },
        "responses": { "201": { "$ref": "#/components/responses/Created" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/comments": {
      "post": {
        "operationId": "postComment",
        "summary": "Add a comment to any object (e.g. a task or commitment). Low-risk internal write.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object", "required": ["objectTable", "objectId", "body"],
            "properties": {
              "objectTable": { "type": "string", "description": "e.g. 'tasks', 'commitments'." },
              "objectId": { "type": "string" },
              "body": { "type": "string" }
            }
          } } }
        },
        "responses": { "201": { "$ref": "#/components/responses/Created" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/proposals": {
      "post": {
        "operationId": "proposeForApproval",
        "summary": "Propose a sensitive/material action for HUMAN approval. Does not execute — files an approval request a person decides in the Decisions module.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object", "required": ["approvalType", "riskLevel"],
            "properties": {
              "approvalType": { "type": "string", "enum": ["executive_access", "bank_destination", "high_value_payment", "contract_change", "pricing_exception", "period_reopen", "bulk_export", "production_credential", "rls_auth_change", "protected_deletion", "agent_autonomy", "high_risk_publication", "deployment_exception"] },
              "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
              "amountMinor": { "type": "integer", "minimum": 0 },
              "dueAt": { "type": "string", "description": "Optional RFC3339/date." }
            }
          } } }
        },
        "responses": { "201": { "description": "Filed for human approval.", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "id": { "type": "string" }, "status": { "type": "string" } } } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/outcomes": {
      "get": {
        "operationId": "listOutcomes",
        "summary": "Company outcomes visible to the user.",
        "responses": { "200": { "description": "Outcomes", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataList" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/commitments": {
      "get": {
        "operationId": "listCommitments",
        "summary": "Commitments visible to the user, with owner names and proofs.",
        "responses": { "200": { "description": "Commitments", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataList" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT", "description": "A Supabase user access token. The request runs as that user with their RLS in force." }
    },
    "responses": {
      "Unauthorized": { "description": "Missing/invalid token, or the user has no active internal membership.", "content": { "application/json": { "schema": { "type": "object", "properties": { "error": { "type": "string" } } } } } },
      "BadRequest": { "description": "Invalid input.", "content": { "application/json": { "schema": { "type": "object", "properties": { "error": { "type": "string" } } } } } },
      "Created": { "description": "Created.", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "id": { "type": "string" } } } } } }
    },
    "schemas": {
      "Me": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string" },
          "displayName": { "type": "string" },
          "organizationId": { "type": "string" },
          "roles": { "type": "array", "items": { "type": "string" } }
        }
      },
      "DataList": {
        "type": "object",
        "properties": { "data": { "type": "array", "items": { "type": "object", "additionalProperties": true } } }
      }
    }
  }
}
