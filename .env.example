NEXT_PUBLIC_SUPABASE_URL=https://tqwnsxjrlomosfblleqy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback supported only while Supabase projects still use anon JWT keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set exactly one privileged server-only key in local/Vercel env; never commit real values.
SUPABASE_SERVER_ONLY_SECRET_KEY=
# Legacy fallback for older Supabase service-role JWTs. Server only; never expose as NEXT_PUBLIC_*.
SUPABASE_SERVER_ONLY_SERVICE_KEY=
# Optional: the client portal's public base URL (e.g. https://portal.kspdominion.group).
# When set, portal invite links are generated as full clickable URLs instead of bare /invite/<token> paths.
NEXT_PUBLIC_PORTAL_BASE_URL=
APP_ENV=local

# --- MCP server (apps/command, /api/mcp) ---
# Optional feature flag. Set to "true" to expose the low-risk write tool
# (create_task) over MCP. Leave unset/empty to keep the server read-only.
# Enabling writes is a governed follow-up slice — do not enable without approval.
MCP_ENABLE_WRITE_TOOLS=
