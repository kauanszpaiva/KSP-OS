# Provisioning environment — copy the values you need and run inline (do NOT commit a filled copy).
# These are used by: pnpm provision:user | provision:portal | seed:everton
#
# Required (from your Supabase project settings — use a NON-Production project):
NEXT_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_SERVER_ONLY_SECRET_KEY="<service-role key — server only, never commit>"

# Password is supplied per run, never stored:
PORTAL_PASSWORD="<a strong password — do not reuse password123>"

# --- Everton is pre-filled by `pnpm seed:everton`; only set these to override ---
# PORTAL_EMAIL="everton@bezgroup.com"
# PORTAL_NAME="Everton"
# CLIENT_ORG_NAME="Bez Group"
# PORTAL_ROLE="client_owner"   # client_owner | client_project_approver | client_billing_contact | client_collaborator | client_viewer
