{
  "name": "ksp-os",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "turbo dev",
    "dev:command": "pnpm --filter @ksp/command dev",
    "dev:portal": "pnpm --filter @ksp/portal dev --port 3001",
    "build": "turbo build",
    "build:command": "pnpm --filter @ksp/command build",
    "build:portal": "pnpm --filter @ksp/portal build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format:check": "turbo format:check",
    "test": "vitest run",
    "test:db": "node scripts/check-db-tests-runner.mjs",
    "test:rls": "node scripts/check-rls.mjs",
    "test:migrations": "node scripts/check-migrations.mjs",
    "test:parity": "node scripts/check-schema-parity.mjs",
    "test:e2e": "node scripts/check-e2e-placeholders.mjs",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "security:secrets": "node scripts/check-secrets.mjs",
    "provision:user": "node scripts/provision-internal-user.mjs",
    "provision:portal": "node scripts/provision-portal-user.mjs",
    "seed:everton": "node scripts/seed-everton.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@playwright/test": "^1.51.1",
    "@testing-library/react": "16.2.0",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.1",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "turbo": "2.3.3",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": "22.x",
    "pnpm": "10.x"
  },
  "dependencies": {
    "resend": "^6.20.0"
  }
}
