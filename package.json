{
  "name": "ksp-os",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @ksp/command dev",
    "dev:command": "pnpm --filter @ksp/command dev",
    "dev:portal": "pnpm --filter @ksp/portal dev",
    "build": "pnpm build:command && pnpm build:portal",
    "build:command": "pnpm --filter @ksp/command build",
    "build:portal": "pnpm --filter @ksp/portal build",
    "lint": "node scripts/check-source.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/check-db-tests.mjs",
    "test:rls": "node scripts/check-rls.mjs && node scripts/check-db-tests.mjs",
    "test:migrations": "node scripts/check-migrations.mjs",
    "test:e2e": "node scripts/check-e2e-placeholders.mjs",
    "format:check": "node scripts/check-format.mjs",
    "security:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@next/env": "15.1.6",
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.48.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@testing-library/react": "16.2.0",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.1",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "2.1.8",
    "turbo": "2.3.3"
  }
}
